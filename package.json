{
  "name": "noticeme",
  "version": "0.1.5",
  "description": "NoticeMe — 本地优先的 Windows 桌面待办与提醒应用",
  "main": "out/main/index.js",
  "author": "DSH",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tendernessnick/noticeme.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "gen:assets": "node scripts/gen-icon.mjs && node scripts/gen-chime.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "npm run typecheck && npm run test && npm run dist && gh release create v%npm_package_version% \"dist/NoticeMe-Setup-%npm_package_version%.exe\" \"dist/NoticeMe-Portable-%npm_package_version%.exe\" --title \"NoticeMe v%npm_package_version%\" --generate-notes"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
